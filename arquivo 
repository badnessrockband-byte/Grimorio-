}<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Grimório — Pesquisa V2</title>
<style>
:root{--bg:#09080b;--p:#151219;--c:#211b24;--l:#4d4052;--t:#f5eff7;--m:#b8adbd;--a:#caa8eb;--s:#392a49}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--t);font:15px system-ui,sans-serif}header{padding:18px;background:#17121a;position:sticky;top:0;z-index:5;border-bottom:1px solid var(--l)}h1{margin:0}.muted{color:var(--m);font-size:.88rem}main{max-width:1150px;margin:auto;padding:12px}.nav{display:flex;gap:7px;overflow:auto;position:sticky;top:79px;background:var(--bg);padding:9px 0;z-index:4}.btn{min-height:44px;padding:9px 12px;border:1px solid var(--l);border-radius:10px;background:var(--p);color:var(--t);cursor:pointer}.on{background:var(--s);border-color:var(--a)}.panel{background:var(--p);border:1px solid var(--l);border-radius:15px;padding:15px;margin-bottom:12px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}.card{background:var(--c);border:1px solid var(--l);border-radius:12px;padding:13px}.wide{width:100%;text-align:left}.detail{margin-top:10px;padding:12px;border-top:1px solid var(--l)}.hidden{display:none}.toolbar{display:flex;gap:8px;flex-wrap:wrap}input{flex:1;min-width:220px;background:#0d0b0f;color:var(--t);border:1px solid var(--l);border-radius:9px;padding:10px;min-height:44px}.badge{display:inline-block;border:1px solid var(--l);border-radius:99px;padding:3px 8px;margin:2px;color:var(--m);font-size:.76rem}.notice{padding:11px;background:#211b25;border-left:3px solid var(--a);color:var(--m)}a{color:var(--a)}.source{margin-top:8px}
@media(max-width:600px){main{padding:8px}.nav{top:73px}.grid{grid-template-columns:1fr}}
</style></head><body><header><h1>📜 Grimório — Pesquisa Histórica V2</h1><div class="muted">Acervo organizado por fonte • navegação por toque • sem afirmar eficácia sobrenatural</div></header><main><nav id="nav" class="nav"></nav><div id="app"></div></main>
<script>
let D,tab=0,q="";
const app=document.getElementById("app"),nav=document.getElementById("nav");
const esc=s=>String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
const tabs=["Visão geral","Ars Goetia — 72","Lemegeton — 5 livros","Clavicula Salomonis","Pronúncia & Áudio","Manuscritos & Fontes","Categorias"];
fetch("data.json").then(r=>r.json()).then(d=>{D=d;tabs.forEach((x,i)=>{let b=document.createElement("button");b.className="btn";b.textContent=x;b.onclick=()=>{tab=i;render()};nav.appendChild(b)});render()});
function render(){[...nav.children].forEach((b,i)=>b.classList.toggle("on",i===tab));if(tab===1)return goetia();if(tab===2)return books();if(tab===3)return key();if(tab===4)return audio();if(tab===5)return sources();if(tab===6)return categories();home()}
function home(){app.innerHTML=`<section class="panel"><h2>Biblioteca de pesquisa</h2><p>Este site organiza o acervo em camadas: fonte → edição → texto → tradução → reconstrução → áudio → imagem → variantes.</p><div class="notice">A pesquisa diferencia material histórico, edição moderna, reconstrução acadêmica e adaptação contemporânea. Não apresenta eficácia sobrenatural como fato.</div></section><section class="grid">${tabs.slice(1).map((x,i)=>`<button class="card wide" data-g="${i+1}"><b>${x}</b><br><span class="muted">Abrir seção</span></button>`).join("")}</section>`;app.querySelectorAll("[data-g]").forEach(b=>b.onclick=()=>{tab=+b.dataset.g;render()})}
function goetia(){app.innerHTML=`<section class="panel"><h2>Ars Goetia — 72 registros</h2><div class="toolbar"><input id="q" placeholder="Pesquisar nome…" value="${esc(q)}"><button class="btn" id="clear">Limpar</button></div><p id="count" class="muted"></p><div id="list" class="grid"></div></section>`;draw();app.querySelector("#q").oninput=e=>{q=e.target.value;draw()};app.querySelector("#clear").onclick=()=>{q="";draw()}}
function draw(){let list=app.querySelector("#list"),a=D.spirits.filter(s=>s.toLowerCase().includes(q.toLowerCase()));list.innerHTML="";app.querySelector("#count").textContent=`${a.length} de 72`;a.forEach((s)=>{let i=D.spirits.indexOf(s),c=document.createElement("article");c.className="card";c.innerHTML=`<button class="btn wide"><b>${i+1}. ${esc(s)}</b><br><span class="badge">atribuição</span><span class="badge">texto</span><span class="badge">pronúncia</span><span class="badge">selo</span></button><div class="detail hidden"><div class="grid">${["Atribuição histórica","Fonte primária","Texto original","Tradução","Pronúncia histórica reconstituída","Áudio","Selo / imagem","Variantes","Referências"].map((x,j)=>`<button class="btn wide" data-z="${j}">${x}</button>`).join("")}</div><div id="z" class="detail">Selecione uma aba da ficha.</div></div>`;c.querySelector(".btn").onclick=()=>c.querySelector(".detail").classList.toggle("hidden");c.querySelectorAll("[data-z]").forEach(b=>b.onclick=()=>c.querySelector("#z").innerHTML=`<h3>${esc(b.textContent)}</h3><p>Campo documental do registro <b>${esc(s)}</b>. A versão completa será preenchida a partir da fonte primária e das variantes identificadas.</p>`);list.appendChild(c)})}
function books(){app.innerHTML=`<section class="panel"><h2>Lemegeton — 5 livros</h2><div class="grid">${D.books.map((b,i)=>`<button class="card wide" data-b="${i}"><b>${i+1}. ${b}</b><br><span class="muted">Abrir pesquisa</span></button>`).join("")}</div><div id="book" class="detail"></div></section>`;app.querySelectorAll("[data-b]").forEach(b=>b.onclick=()=>app.querySelector("#book").innerHTML=`<h3>${b.textContent}</h3><p>Índice interno, manuscritos, variantes, traduções e notas críticas.</p>`)}
function key(){app.innerHTML=`<section class="panel"><h2>Clavicula Salomonis</h2><p>Base documental central do projeto.</p><div class="grid"><button class="card wide" onclick="window.open('https://wellcomecollection.org/works/xhh2qvud','_blank')"><b>📖 Edição de 1889</b><br><span class="muted">Wellcome Collection — 166 imagens — Public Domain Mark</span></button><button class="card wide" onclick="window.open('https://wellcomecollection.org/works/xhh2qvud/items','_blank')"><b>🖼️ Páginas digitalizadas</b><br><span class="muted">Visualização página a página</span></button></div></section>`}
function audio(){app.innerHTML=`<section class="panel"><h2>🔊 Pronúncia histórica reconstituída</h2><div class="notice">O projeto usa a etiqueta “pronúncia histórica reconstituída” para reconstruções linguísticas. Isso não significa gravação autêntica da época.</div><div class="grid">${["Latim","Hebraico","Grego","Francês","Inglês histórico"].map(x=>`<button class="card wide"><b>${x}</b><br><span class="muted">Grafia → reconstrução → áudio → notas</span></button>`).join("")}</div></section>`}
function sources(){app.innerHTML=`<section class="panel"><h2>Manuscritos & Fontes</h2><div class="grid">${D.sources.map((s,i)=>`<article class="card"><button class="btn wide" data-s="${i}"><b>${esc(s.title)}</b><br><span class="muted">${esc(s.status)}</span></button><div id="s${i}" class="detail hidden"><p>${esc(s.detail)}</p><a href="${esc(s.url)}" target="_blank" rel="noopener">Abrir fonte original</a></div></article>`).join("")}</div></section>`;app.querySelectorAll("[data-s]").forEach(b=>b.onclick=()=>app.querySelector("#s"+b.dataset.s).classList.toggle("hidden"))}
function categories(){let c=["Proteção & Expulsão","Limpeza espiritual","Limpeza energética","Prosperidade","Abrir caminhos","Cura / Auto-cuidado","Proteção angelical","Sigilos & Pentáculos"];app.innerHTML=`<section class="panel"><h2>Categorias de pesquisa</h2><div class="grid">${c.map(x=>`<button class="card wide"><b>${x}</b><br><span class="muted">Fonte → operação → tradução → pronúncia → sigilo → variantes</span></button>`).join("")}</div></section>`}
</script></body></html>
